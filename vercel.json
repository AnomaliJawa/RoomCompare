{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "true",
  "buildCommand": "rm -rf public && mkdir public && cp -R index.html favicon.ico site.webmanifest src styles icons seed-photos public/",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{tests/**,seed-photos/**,icons/**,src/**,styles/**,design/**,node_modules/**,public/**,index.html,favicon.ico,site.webmanifest,*.mjs,*.md,package*.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
