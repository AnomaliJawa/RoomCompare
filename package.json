{
  "name": "roomcompare",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Record, organize and compare surveyed boarding houses.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/index.js --dev",
    "build": "vite build",
    "prestart": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "vitest run",
    "test:client": "vitest run --project client",
